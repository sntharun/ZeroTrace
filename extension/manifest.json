{
  "manifest_version": 3,
  "name": "PrivacyLens Agent",
  "version": "1.0.0",
  "description": "Privacy-preserving browser agent that redacts PII locally.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PrivacyLens"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/dom-analyzer.js",
        "content/action-executor.js",
        "content/overlay.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["models/*", "*.wasm"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
